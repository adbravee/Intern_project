@{
    ViewData["Title"] = "Error";
}

<div class="text-center mt-5">
    <i class="bi bi-bug-fill text-danger" style="font-size:4rem;"></i>
    <h1 class="mt-3 text-danger">Oops! Something went wrong.</h1>
    <p class="text-muted">An unexpected error occurred. Please try again or contact support.</p>
    <a asp-controller="Items" asp-action="Index" class="btn btn-primary mt-2">
        <i class="bi bi-house me-1"></i>Back to Home
    </a>
</div>
