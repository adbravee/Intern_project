@model IEnumerable<ItemProcessingApp.Models.Item>

@{
    ViewData["Title"] = "Processed Items";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-diagram-2 text-primary me-2"></i>Processed Items
    </h2>
    <a asp-action="Process" class="btn btn-primary">
        <i class="bi bi-diagram-3 me-1"></i>Process Item
    </a>
</div>

<form asp-action="Processed" method="get" class="mb-4">
    <div class="input-group shadow-sm" style="max-width:450px;">
        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
        <input type="text" name="search" value="@ViewData["CurrentSearch"]"
               class="form-control" placeholder="Search by name…" />
        <button type="submit" class="btn btn-primary">Search</button>
        @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()))
        {
            <a asp-action="Processed" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        No processed items found.
        <div class="mt-2">
            <a asp-action="Process" class="btn btn-sm btn-primary">
                <i class="bi bi-diagram-3 me-1"></i>Process your first item
            </a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th><i class="bi bi-tag me-1"></i>Name</th>
                        <th><i class="bi bi-speedometer2 me-1"></i>Weight (kg)</th>
                        <th><i class="bi bi-diagram-3 me-1"></i>Outputs</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted small">@item.Id</td>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@item.Weight.ToString("0.###")</td>
                            <td>
                                <span class="badge bg-secondary">
                                    @item.Children.Count output item(s)
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Tree"
                                   class="btn btn-sm btn-outline-primary"
                                   title="Open tree view">
                                    <i class="bi bi-diagram-2"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted small">
            Showing @Model.Count() item(s) that already have children.
        </div>
    </div>
}

