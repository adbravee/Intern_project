@model Item
@{
    ViewData["Title"] = $"Details – {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-md-7">

        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h2 class="fw-bold mb-0">
                <i class="bi bi-eye text-info me-2"></i>Item Details
            </h2>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <span class="fw-semibold">@Model.Name</span>
                <span class="badge bg-secondary">#@Model.Id</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4"><i class="bi bi-tag me-1"></i>Name</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4"><i class="bi bi-speedometer2 me-1"></i>Weight</dt>
                    <dd class="col-sm-8">@Model.Weight.ToString("0.###") kg</dd>

                    <dt class="col-sm-4"><i class="bi bi-diagram-2 me-1"></i>Parent</dt>
                    <dd class="col-sm-8">
                        @if (Model.Parent is not null)
                        {
                            <a asp-action="Details" asp-route-id="@Model.Parent.Id"
                               class="badge bg-secondary text-decoration-none">
                                <i class="bi bi-arrow-up me-1"></i>@Model.Parent.Name (#@Model.Parent.Id)
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">— Root item (no parent) —</span>
                        }
                    </dd>

                    <dt class="col-sm-4"><i class="bi bi-diagram-3 me-1"></i>Children</dt>
                    <dd class="col-sm-8">
                        @if (Model.Children.Any())
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var child in Model.Children.OrderBy(c => c.Name))
                                {
                                    <li>
                                        <a asp-action="Details" asp-route-id="@child.Id"
                                           class="badge bg-primary text-decoration-none me-1 mb-1">
                                            <i class="bi bi-arrow-down me-1"></i>@child.Name
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted small">No children yet.</span>
                        }
                    </dd>
                </dl>
            </div>
            <div class="card-footer d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
                <a asp-action="AddChild" asp-route-id="@Model.Id" class="btn btn-success btn-sm">
                    <i class="bi bi-diagram-3 me-1"></i>Add Child
                </a>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">
                    <i class="bi bi-trash me-1"></i>Delete
                </a>
                <a asp-action="Tree" class="btn btn-outline-primary btn-sm ms-auto">
                    <i class="bi bi-diagram-2 me-1"></i>Tree View
                </a>
            </div>
        </div>

    </div>
</div>
