@model Item
@{
    ViewData["Title"] = $"Delete – {Model.Name}";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Delete</h5>
            </div>
            <div class="card-body">
                <p class="lead">Are you sure you want to delete this item?</p>

                <dl class="row">
                    <dt class="col-sm-3">ID</dt>
                    <dd class="col-sm-9">#@Model.Id</dd>

                    <dt class="col-sm-3">Name</dt>
                    <dd class="col-sm-9"><strong>@Model.Name</strong></dd>

                    <dt class="col-sm-3">Weight</dt>
                    <dd class="col-sm-9">@Model.Weight.ToString("0.###") kg</dd>

                    <dt class="col-sm-3">Parent</dt>
                    <dd class="col-sm-9">
                        @(Model.Parent?.Name ?? "— Root —")
                    </dd>

                    <dt class="col-sm-3">Children</dt>
                    <dd class="col-sm-9">
                        @if (Model.Children.Any())
                        {
                            <span class="badge bg-danger">@Model.Children.Count child(ren) — cannot delete!</span>
                        }
                        else
                        {
                            <span class="badge bg-success">None — safe to delete</span>
                        }
                    </dd>
                </dl>

                @if (Model.Children.Any())
                {
                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle me-2"></i>
                        This item has <strong>@Model.Children.Count</strong> child item(s).
                        You must delete or re-parent them before deleting this item.
                    </div>
                }
            </div>
            <div class="card-footer d-flex gap-2">
                @if (!Model.Children.Any())
                {
                    <form asp-action="Delete" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i>Yes, Delete
                        </button>
                    </form>
                }
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-1"></i>Cancel
                </a>
            </div>
        </div>
    </div>
</div>
