@model IEnumerable<Item>
@{
    ViewData["Title"] = "All Items";
}

<!-- Page header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-list-ul text-primary me-2"></i>All Items
    </h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>New Item
    </a>
</div>

<!-- Search bar -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group shadow-sm" style="max-width:450px;">
        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
        <input type="text" name="search" value="@ViewData["CurrentSearch"]"
               class="form-control" placeholder="Search by name…" />
        <button type="submit" class="btn btn-primary">Search</button>
        @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
        }
    </div>
</form>

<!-- Items table -->
@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        No items found.
        @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()))
        {
            <span>Try a different search term or <a asp-action="Index">view all items</a>.</span>
        }
        else
        {
            <span><a asp-action="Create">Create your first item!</a></span>
        }
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th><i class="bi bi-tag me-1"></i>Name</th>
                        <th><i class="bi bi-speedometer2 me-1"></i>Weight (kg)</th>
                        <th><i class="bi bi-diagram-2 me-1"></i>Parent</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-muted small">@item.Id</td>
                            <td class="fw-semibold">@item.Name</td>
                            <td>@item.Weight.ToString("0.###")</td>
                            <td>
                                @if (item.Parent is not null)
                                {
                                    <span class="badge bg-secondary">
                                        <i class="bi bi-arrow-up me-1"></i>@item.Parent.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">— Root —</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-info" title="Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-warning" title="Edit">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-action="AddChild" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-success" title="Add Child">
                                    <i class="bi bi-diagram-3"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-danger" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer text-muted small">
            Showing @Model.Count() item(s)
            @if (!string.IsNullOrEmpty(ViewData["CurrentSearch"]?.ToString()))
            {
                <span>for search "<strong>@ViewData["CurrentSearch"]</strong>"</span>
            }
        </div>
    </div>
}

<!-- Quick links -->
<div class="mt-4 d-flex gap-2">
    <a asp-action="Tree" class="btn btn-outline-primary">
        <i class="bi bi-diagram-2 me-1"></i>View Tree
    </a>
</div>
