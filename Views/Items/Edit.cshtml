@model Item
@{
    ViewData["Title"] = $"Edit – {Model.Name}";
}

<div class="row justify-content-center">
    <div class="col-md-6">

        <div class="d-flex align-items-center mb-4">
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-3">
                <i class="bi bi-arrow-left"></i>
            </a>
            <h2 class="fw-bold mb-0">
                <i class="bi bi-pencil text-warning me-2"></i>Edit Item
            </h2>
        </div>

        <div class="card shadow-sm">
            <div class="card-header text-muted small">
                Item ID: <strong>#@Model.Id</strong>
            </div>
            <div class="card-body p-4">

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <!-- Name -->
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Weight -->
                    <div class="mb-3">
                        <label asp-for="Weight" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="Weight" class="form-control" type="number"
                                   step="0.001" min="0.001" />
                            <span class="input-group-text">kg</span>
                        </div>
                        <span asp-validation-for="Weight" class="text-danger small"></span>
                    </div>

                    <!-- Parent -->
                    <div class="mb-4">
                        <label asp-for="ParentId" class="form-label fw-semibold">
                            Parent Item <span class="text-muted fw-normal">(optional)</span>
                        </label>
                        <select asp-for="ParentId" asp-items="ViewBag.ParentId" class="form-select">
                            <option value="">— No parent (root item) —</option>
                        </select>
                        <span asp-validation-for="ParentId" class="text-danger small"></span>
                        <div class="form-text text-warning">
                            <i class="bi bi-exclamation-triangle me-1"></i>
                            Setting an invalid parent (ancestor) is prevented automatically.
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-save me-1"></i>Save Changes
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
